# Copia este archivo como .env y ajusta los valores.
# Docker Compose lo lee para levantar la base de datos.
# La aplicacion no lee .env: application.yml ya trae estos mismos valores por omision.

DB_URL=jdbc:postgresql://localhost:5432/mira
DB_USER=mira
DB_PASSWORD=mira
SPRING_PROFILES_ACTIVE=dev
APP_UPLOAD_DIR=./uploads
