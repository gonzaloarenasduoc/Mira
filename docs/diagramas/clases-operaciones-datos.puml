package "entity" {
  class Arriendo <<Entity>> {
    - fechaInicio : LocalDate
    - fechaRetornoComprometida : LocalDate
    - numeroOrdenCompra : String
    + registrarRetorno(linea, fecha, observacion) : void
    + agregarLinea(equipoId, tarifaDiaria) : void
  }
  class Cliente <<Entity>> {
    - rut : String
    - razonSocial : String
    - giro : String
    - direccion : String
    - comuna : String
    - contactoNombre : String
    - contactoEmail : String
    - contactoTelefono : String
    - activo : boolean
    + actualizar(razonSocial, giro, direccion, comuna, contactoNombre, contactoEmail, contactoTelefono) : void
    + cambiarEstado(activo) : void
  }
  abstract class Operacion <<Entity>> {
    - usuarioId : Long
    - fecha : LocalDate
    - observaciones : String
  }
  class OperacionDetalle <<Entity>> {
    - equipoId : Long
    - valorUnitario : BigDecimal
    - fechaRetornoReal : LocalDate
    - observacion : String
    + estaPendienteDeRetorno() : boolean
  }
  class Venta <<Entity>> {
    - numeroOrdenCompra : String
    + agregarLinea(equipoId, valor) : void
  }
}
