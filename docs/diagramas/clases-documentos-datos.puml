@startuml clases-documentos-datos
!include _estilo.iuml
hide empty members
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 45
title Documentos de las operaciones (E008) · datos

package "service" {
  class DocumentoService <<Service>> {
  }
}
package "repository" {
  interface DocumentoRepository <<Repository>> {
    + findByEmpresaIdAndOperacionIdInOrderByFechaEmisionDescIdDesc(empresaId, operaciones) : List<Documento>
    + findByEmpresaIdAndOperacionIdOrderByFechaEmisionDescIdDesc(empresaId, operacionId) : List<Documento>
    + findByIdAndEmpresaId(id, empresaId) : Optional<Documento>
  }
}
package "entity" {
  class Documento <<Entity>> {
    - operacionId : Long
    - tipo : TipoDocumento
    - numeroFolio : String
    - fechaEmision : LocalDate
    - nombreArchivo : String
    - rutaArchivo : String
    - contentType : String
    - tamanoBytes : long
  }
  enum TipoDocumento {
    ORDEN_COMPRA
    GUIA_DESPACHO
    FACTURA
    + getEtiqueta() : String
  }
}
package "otros módulos" #F7F7F7 {
  class Empresa <<Entity>>
  interface EmpresaRepository <<Repository>>
  abstract class EntidadAuditable <<Entity>>
}
DocumentoRepository ..> Documento : <<manage>>
DocumentoService --> "1" DocumentoRepository
DocumentoService --> "1" EmpresaRepository
Documento --|> EntidadAuditable
Documento "*" --> "1" Empresa : empresa
Documento ..> TipoDocumento
@enduml
