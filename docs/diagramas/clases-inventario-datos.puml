    - fechaAdquisicion : LocalDate
    - valorAdquisicion : BigDecimal
    - tarifaDiaria : BigDecimal
    - observaciones : String
    - activo : boolean
  }
  class Movimiento <<Entity>> {
    - tipo : TipoMovimiento
    - fecha : LocalDateTime
    - operacionId : Long
    - usuarioId : Long
    - observacion : String
    + registrar(equipo, tipo, fecha, origen, destino, usuarioId, observacion) : Movimiento {static}
    + registrar(equipo, tipo, fecha, origen, destino, operacionId, usuarioId, observacion) : Movimiento {static}
  }
  enum EstadoEquipo <<enumeration>> {
    DISPONIBLE
    ARRENDADO
    EN_TRANSITO
    EN_MANTENCION
    VENDIDO
    + getEtiqueta() : String
  }
  enum TipoMovimiento <<enumeration>> {
    INGRESO
    TRASLADO_SALIDA
    TRASLADO_LLEGADA
    SALIDA_ARRIENDO
    RETORNO_ARRIENDO
    SALIDA_VENTA
    ENTRADA_MANTENCION
    SALIDA_MANTENCION
    + getEtiqueta() : String
    + getEstadoResultante() : EstadoEquipo
    + isReubica() : boolean
  }
}
