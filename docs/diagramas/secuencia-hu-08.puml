@startuml secuencia-hu-08
!include _estilo.iuml
hide footbox
skinparam maxMessageSize 260
skinparam sequenceMessageAlign left
mainframe sd HU-08 Administrar bodegas
actor "Administrador" as A
participant "bodegas/formulario.html" as L_VISTA_bodegas_formulario <<boundary>>
participant ":BodegaController" as L_BodegaController <<control>>
participant ":BodegaService" as L_BodegaService
participant ":BodegaRepository" as L_BodegaRepository
participant ":Bodega" as L_Bodega <<entity>>
A -> L_VISTA_bodegas_formulario : registra una bodega con nombre y comuna
L_VISTA_bodegas_formulario -> L_BodegaController : POST /bodegas
alt nombre no repetido en la empresa
L_BodegaController -> L_BodegaService : crear(empresaId, request)
L_BodegaService -> L_BodegaService : validarNombreLibre()
L_BodegaService -> L_BodegaRepository : findByEmpresaIdAndNombreIgnoreCase(empresaId, nombre)
L_BodegaRepository --> L_BodegaService : Optional<Bodega>
L_BodegaService --> L_Bodega : <<create>>
L_BodegaService -> L_BodegaRepository : save()
L_BodegaService --> L_BodegaController : BodegaResponse
L_BodegaController --> L_VISTA_bodegas_formulario : redirige al listado de bodegas
else ya existe una bodega con ese nombre
L_BodegaService --> L_BodegaController : <<exception>> NegocioException
L_BodegaController --> L_VISTA_bodegas_formulario : formulario con el mensaje
end
L_VISTA_bodegas_formulario --> A : bodega creada o el mensaje
@enduml
